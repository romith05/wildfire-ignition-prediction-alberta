{
  "description": "Template feature config for extracting Model B 1 km coarse inference patches. Copy this file to configs/model_b_1km_features.json and replace placeholder raster paths and weather values locally.",
  "important_notes": [
    "Keep feature keys consistent with the keys used during Model B training and channel_stats_1km.json.",
    "Do not commit local absolute paths, API keys, or private raster locations.",
    "Static layers should point to aligned 1 km rasters in the same CRS/grid family used for training.",
    "Weather features are represented as constant arrays for now; later they should be filled from a realtime weather provider before extraction.",
    "Multiband rasters must be represented as one feature entry per model channel. Use the same path with different band values."
  ],
  "features": [
    {
      "key": "elevation",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/elevation_1km.tif",
      "band": 1,
      "resampling": "bilinear",
      "fill_value": 0.0
    },
    {
      "key": "landcover",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/landcover_1km.tif",
      "band": 1,
      "resampling": "nearest",
      "fill_value": 0.0
    },
    {
      "key": "water_mask",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/water_mask_1km.tif",
      "band": 1,
      "resampling": "nearest",
      "fill_value": 0.0
    },
    {
      "key": "municipality_band_1",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/municipality_1km_multiband.tif",
      "band": 1,
      "resampling": "nearest",
      "fill_value": 0.0
    },
    {
      "key": "municipality_band_2",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/municipality_1km_multiband.tif",
      "band": 2,
      "resampling": "nearest",
      "fill_value": 0.0
    },
    {
      "key": "municipality_band_3",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/municipality_1km_multiband.tif",
      "band": 3,
      "resampling": "nearest",
      "fill_value": 0.0
    },
    {
      "key": "distance_to_road",
      "source": "raster",
      "path": "/ABSOLUTE/PATH/TO/STATIC_1KM/distance_to_road_1km.tif",
      "band": 1,
      "resampling": "bilinear",
      "fill_value": 0.0
    },
    {
      "key": "temperature",
      "source": "constant",
      "value": 20.0
    },
    {
      "key": "relative_humidity",
      "source": "constant",
      "value": 35.0
    },
    {
      "key": "wind_speed",
      "source": "constant",
      "value": 10.0
    }
  ]
}
